# Server
PORT=3000
NODE_ENV=development

# Storage
STORAGE_ROOT=/tmp/loony-s3/data
DB_PATH=/tmp/loony-s3/metadata.db

# Auth
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRY=24h

# Presigned URLs
PRESIGNED_SECRET=another-secret-for-presigned-urls
PRESIGNED_MAX_EXPIRY_SECONDS=604800

# Multipart uploads
MAX_PART_SIZE_BYTES=104857600
MIN_PART_SIZE_BYTES=5242880
MAX_PARTS=10000

# Upload limits
MAX_OBJECT_SIZE_BYTES=5368709120

# Base URL (used in presigned URL generation)
BASE_URL=http://localhost:3000
