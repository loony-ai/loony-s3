{
  "name": "loony-s3",
  "version": "1.0.0",
  "description": "A simplified, scalable object storage service inspired by Amazon S3",
  "main": "dist/server.js",
  "scripts": {
    "dev": "NODE_OPTIONS='--experimental-sqlite' ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "NODE_OPTIONS='--experimental-sqlite' node dist/server.js",
    "start:dev": "NODE_OPTIONS='--experimental-sqlite' node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.3",
    "express-rate-limit": "^8.3.2",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "pg": "^8.20.0",
    "uuid": "^9.0.1",
    "winston": "^3.12.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.3",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^9.0.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.2"
  }
}
